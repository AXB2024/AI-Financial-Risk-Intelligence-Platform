PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=finance_db
DB_RETRY_ATTEMPTS=8
DB_RETRY_DELAY=3000
DB_LOGGING=true
ML_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
TYPEORM_SYNC=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
REDIS_URL=redis://localhost:6379
JOB_WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# Get a free key at https://finnhub.io/register (60 calls/min free tier).
# Leave blank to fall back to synthetic mock prices/news/returns.
FINNHUB_API_KEY=
# Optional. OpenFIGI works without a key at lower rate limits.
# Add a key for higher throughput during batch ingestion.
OPENFIGI_API_KEY=
